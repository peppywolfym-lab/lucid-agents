# -----------------------------------------------------------
# Stage 1: Dependency resolution and build
# -----------------------------------------------------------
FROM oven/bun:1.3-alpine AS builder

WORKDIR /app

# Copy dependency specifications first to leverage layer caching
COPY package.json bun.lock* ./

# Install production dependencies
RUN bun install --frozen-lockfile --production

# Copy application source code
COPY . .

# -----------------------------------------------------------
# Stage 2: Minimal runtime image
# -----------------------------------------------------------
FROM oven/bun:1.3-alpine AS runner

WORKDIR /app

# Set production environment flags
ENV NODE_ENV=production
ENV PORT=3000

# Copy node_modules and built/source assets from builder
COPY --from=builder /app /app

# Run as non-root user for container security
USER bun

# Expose internal listening port
EXPOSE 3000

# Health check to ensure the agent is running and responsive
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Start the agent runtime
CMD ["bun", "run", "start"]
